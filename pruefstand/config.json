{
  "title": "CRSF-Router S3 Prüfstand",
  "firmwares": [
    {
      "id": "router",
      "name": "CRSF-Router S3",
      "dir": "firmware/RC_CRSF_Router",
      "page": {
        "file": "webui.h",
        "var": "WEBUI_HTML"
      },
      "mock": "mock_router.js",
      "version": "FW_VERSION",
      "lua": {
        "files": [
          "src/RC_Common/*.h",
          "*.h",
          "*.cpp",
          "*.ino"
        ],
        "expect_max": "LUA_COUNT"
      },
      "api": {
        "GET /api/status": "routerStatusJson",
        "GET /api/config": "configJson"
      },
      "api_files": [
        "src/RC_Common/*.h",
        "*.h",
        "*.cpp",
        "*.ino"
      ],
      "api_init": [
        "cfgDefaults"
      ],
      "export": [
        "PIN_UPLINK_RX",
        "PIN_UPLINK_TX",
        "PIN_PORTB_RX",
        "PIN_PORTB_TX",
        "PIN_PORTC_RX",
        "PIN_PORTC_TX",
        "PIN_STATUS_LED",
        "PIN_VSENSE"
      ],
      "variants": [
        {
          "id": "s3",
          "name": "ESP32-S3 Zero",
          "defines": {
            "CONFIG_IDF_TARGET_ESP32S3": "1"
          }
        }
      ]
    }
  ]
}